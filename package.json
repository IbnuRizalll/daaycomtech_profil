{
  "name": "daaycomtech-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:ci": "next lint --max-warnings=0 --no-cache",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "ubuntu:db:up": "docker compose -f docker-compose.ubuntu.yml up -d --wait --wait-timeout 180",
    "ubuntu:db:down": "docker compose -f docker-compose.ubuntu.yml down",
    "ubuntu:db:reset": "docker compose -f docker-compose.ubuntu.yml down -v && docker compose -f docker-compose.ubuntu.yml up -d",
    "ubuntu:db:push": "docker compose -f docker-compose.ubuntu.yml up -d --wait --wait-timeout 180 && bash scripts/ubuntu-run.sh npm run db:push",
    "ubuntu:db:seed": "docker compose -f docker-compose.ubuntu.yml up -d --wait --wait-timeout 180 && bash scripts/ubuntu-run.sh npm run db:seed",
    "ubuntu:dev": "bash scripts/ubuntu-run.sh npm run dev"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@radix-ui/react-accordion": "^1.1.2",
    "@radix-ui/react-dialog": "^1.0.5",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-tabs": "^1.0.4",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.395.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.13",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sharp": "^0.33.4",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.38",
    "prisma": "^5.15.0",
    "tailwindcss": "^3.4.4",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5"
  }
}
